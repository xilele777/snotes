# Copy to .env.server for npm start, or .env for Docker Compose.
# Generate a random token: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ACCESS_TOKEN=
# Direct Node.js deployment only:
HOST=127.0.0.1
PORT=3000
SNOTES_DATA_DIR=./data
# Optional for both: auto-purge notes that stayed in the trash longer than N days (empty or 0 = off).
TRASH_RETENTION_DAYS=
