# Copy to .env.server for npm start, or .env for Docker Compose.
# Generate a random token: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ACCESS_TOKEN=
# Direct Node.js deployment only:
HOST=127.0.0.1
PORT=3000
SNOTES_DATA_DIR=./data
# Optional for both: auto-purge after N days (empty = 30 days; 0 or off = disabled).
TRASH_RETENTION_DAYS=
# Optional external recovery epoch override; rotate after any restore.
# Otherwise the server persists data/sync-epoch.
# SYNC_INSTANCE_EPOCH=
# Restored instances automatically require upgraded epoch-aware clients.
# SYNC_REQUIRE_EPOCH=true
