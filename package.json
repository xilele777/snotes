{
  "name": "snotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local --port 8787",
    "build": "vite build",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.worker.json tsconfig.node.json",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:all": "npm test && npm run test:worker",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@milkdown/core": "^7.15.5",
    "@milkdown/preset-commonmark": "^7.15.5",
    "@milkdown/vue": "^7.15.5",
    "dexie": "^4.0.8",
    "hono": "^4.6.14",
    "pinia": "^2.2.6",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@cloudflare/vitest-pool-workers": "^0.5.29",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "vite-plugin-pwa": "^0.21.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
