{
  "name": "snotes",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "icons:generate": "node scripts/gen-icons.cjs",
    "build": "npm run typecheck && vite build",
    "build:server": "npm run typecheck && node scripts/build-server.mjs",
    "start": "node --env-file-if-exists=.env.server dist-server/index.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:all": "npm run test && npm run test:worker && npm run test:server",
    "test:e2e": "playwright test",
    "test:e2e:server": "playwright test --config playwright.server.config.ts",
    "typecheck": "vue-tsc -b --force"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@milkdown/kit": "^7.22.1",
    "@milkdown/vue": "^7.22.1",
    "dexie": "^4.4.5",
    "fflate": "^0.8.3",
    "hono": "^4.13.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.125.0"
  }
}
