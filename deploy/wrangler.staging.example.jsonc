{
  // Copy to PROJECT ROOT as wrangler.staging.local.jsonc before running commands.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snotes-acceptance-demo",
  "account_id": "REPLACE_WITH_YOUR_ACCOUNT_ID",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "snotes-acceptance-demo",
    "database_id": "REPLACE_WITH_DEDICATED_STAGING_DATABASE_ID",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "snotes-acceptance-demo" }],
  "vars": { "SYNC_REQUIRE_EPOCH": "true", "TRASH_RETENTION_DAYS": "off" }
}
